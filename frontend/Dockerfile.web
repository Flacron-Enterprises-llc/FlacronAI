# Static frontend image for container hosts (IBM Code Engine).
# Vite bakes VITE_* values in at build time, so each cloud builds its own
# image from the same commit with its own build args. These values are public
# by design (Firebase web config, browser Maps key, API URL) -- never pass
# server secrets here.

# Same pinned Node base as backend/Dockerfile.
FROM node:24.21.0-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-fund --no-audit

COPY . .

ARG VITE_API_URL
ARG VITE_FIREBASE_API_KEY
ARG VITE_FIREBASE_AUTH_DOMAIN
ARG VITE_FIREBASE_PROJECT_ID
ARG VITE_FIREBASE_STORAGE_BUCKET
ARG VITE_FIREBASE_MESSAGING_SENDER_ID
ARG VITE_FIREBASE_APP_ID
ARG VITE_FIREBASE_MEASUREMENT_ID
ARG VITE_GOOGLE_MAPS_BROWSER_KEY
ARG VITE_ADMIN_EMAIL
RUN test -n "$VITE_API_URL" || (echo "VITE_API_URL build arg is required" && exit 1) \
    && npm run build

# Unprivileged nginx (runs as uid 101, listens on 8080). Pinned by digest.
FROM nginxinc/nginx-unprivileged:1.30.6-alpine@sha256:782bb89768cc87b7f95c18b95baa1af250e5d451f26794f59363540161147c01
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
