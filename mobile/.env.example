# FlacronAI mobile — environment variable names only. No real values belong in this file
# or in any committed file. Copy this to .env.local (git-ignored) and fill in real values
# for local development only.
#
# Only EXPO_PUBLIC_*-prefixed variables may be read by client code — anything without
# that prefix is never safe to reference from mobile code (see
# mobile/MOBILE_DEVELOPMENT_PHASES.md §9 for the full policy).

# Backend API base URL. NOT YET CONFIRMED — the production backend deploys to AWS
# ECS (see mobile/MOBILE_DEVELOPMENT_PHASES.md §2 for how this was verified), but no
# public API base URL/domain for it could be confirmed from the repository. Do not
# invent one. Leave this pointed at local dev until a real value is confirmed.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Human-readable environment name, used only for in-app diagnostics/labeling.
EXPO_PUBLIC_APP_ENV=development

# Firebase client config for the mobile app's registered Firebase "app" (iOS/Android).
# This is a public client identifier, not a secret — but it does not exist yet: no
# iOS/Android app has been registered against the existing Firebase project
# (FIREBASE_PROJECT_ID in backend/.env.example) as of this foundation phase. Populate
# once that registration happens, in Phase 3 (Authentication) — never fabricate values
# here in the meantime.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
