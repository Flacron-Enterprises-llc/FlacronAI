# FlacronAI mobile — environment variable names only. No real values belong in this file
# or in any committed file. Copy this to .env.local (git-ignored) and fill in real values
# for local development only.
#
# Only EXPO_PUBLIC_*-prefixed variables may be read by client code — anything without
# that prefix is never safe to reference from mobile code (see
# mobile/MOBILE_DEVELOPMENT_PHASES.md §9 for the full policy).

# Human-readable environment name. Required — mobile/src/config/env.ts throws a clear
# error if this is unset or not one of the three values below, rather than silently
# assuming "development". Valid values: development | preview | production
# (these match the three mobile/eas.json build profiles exactly).
EXPO_PUBLIC_APP_ENV=development

# Backend API base URL.
#
# "localhost" is NOT universal across mobile dev targets (Phase 2 addendum) — it only
# reaches a backend on the SAME machine. The value you need depends on where the app is
# actually running:
#
#   iOS Simulator (same machine)  -> http://localhost:3000/api/v1        (the default below)
#   Android Emulator              -> http://10.0.2.2:3000/api/v1        (emulator's alias for the host machine)
#   Physical phone, same Wi-Fi    -> http://<YOUR_COMPUTER_LAN_IP>:3000/api/v1
#                                     (find it with `ipconfig` on Windows / `ifconfig`
#                                     or `ipconfig getifaddr en0` on macOS — it changes
#                                     between networks, so it is NEVER hardcoded here;
#                                     set it in your own git-ignored .env.local only)
#                                     — or use a secure tunnel (see mobile/README.md).
#   Expo web                      -> http://localhost:3000/api/v1        (same as iOS Simulator)
#
# The default below (http://localhost:3000/api/v1) is CONFIRMED correct only for the iOS
# Simulator and Expo web (backend/Dockerfile sets PORT=3000; backend/server.js mounts
# every route under both /api and the versioned /api/v1 — mobile targets /api/v1
# exclusively, never the legacy alias). If you are on the Android Emulator or a physical
# device, override this in your own .env.local — do not rely on the default.
#
# NOT YET CONFIRMED for preview/production, and this is a DIFFERENT problem from the
# per-device dev addresses above: it is a genuinely unresolved public HTTPS origin, not
# a device-targeting question. The production backend deploys to AWS ECS (see
# mobile/MOBILE_DEVELOPMENT_PHASES.md §2 for how this was verified) but no public ALB DNS
# name or custom domain in front of it exists anywhere in this repository.
# `https://flacronai.com` was directly checked on 2026-09-08 (safe, unauthenticated GET
# requests to /api/v1, /api/, and /health) and confirmed to be Vercel's static frontend —
# it returns the SPA's index.html (text/html) for every path, not a real backend
# response, so it must NOT be used as a mobile API origin. Do not invent a URL here.
# This is an external infrastructure dependency: it requires confirmation from whoever
# owns the AWS ECS service's networking (an ALB DNS name or a custom domain in front of
# it), not something this repository can resolve on its own.
#
# For preview/production, this variable has NO default and MUST be a real, confirmed,
# publicly reachable HTTPS value supplied via an EAS environment variable (not committed
# here) — src/config/env.ts also rejects placeholders, localhost/emulator/private-LAN
# addresses, and non-HTTPS URLs for these two environments. See
# mobile/MOBILE_DEVELOPMENT_PHASES.md §10 item 1.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Firebase client config for the mobile app's registered Firebase "app" (iOS/Android).
# This is a public client identifier, not a secret — but it does not exist yet: no
# iOS/Android app has been registered against the existing Firebase project
# (FIREBASE_PROJECT_ID in backend/.env.example) as of this foundation phase. Populate
# once that registration happens, in Phase 3 (Authentication) — never fabricate values
# here in the meantime.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In (Phase 3). Also a public client identifier, not a secret — but neither
# exists yet: obtaining them requires Google Cloud/Firebase console access (see
# mobile/AUTHENTICATION_ARCHITECTURE.md §7). Until EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID is set,
# the Google Sign-In button renders in a disabled "setup required" state
# (src/features/auth/services/googleSignIn.ts) rather than attempting a call that could
# only fail. Google Sign-In also requires an EAS development build — it does not work in
# Expo Go (see mobile/README.md).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS-specific client ID — optional; only needed if it differs from the web client ID flow
# requires (see @react-native-google-signin/google-signin's ConfigureParams.iosClientId).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Sign in with Apple needs NO client-side env var — expo-apple-authentication uses the
# device's native Apple ID sign-in UI directly, and the resulting credential is exchanged
# with Firebase using this app's existing bundle ID (already configured in app.config.ts).
# It DOES require the "Sign In with Apple" capability enabled on the App ID in the Apple
# Developer portal, and the Apple provider configured in the Firebase console, before a
# real sign-in can complete — see mobile/AUTHENTICATION_ARCHITECTURE.md §7.
