rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'admin@flacronenterprises.com';
    }

    function getUserTier() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tier;
    }

    function isEnterprise() {
      return isAuthenticated() && getUserTier() == 'enterprise';
    }

    // users/{uid}: clients may change ONLY plain profile fields on their own doc.
    // Everything else -- tier and every entitlement source (stripeTier, adminTier,
    // legacyTier, storeEntitlement, storeSubscriptionIds, team membership fields),
    // billing ids, MFA/session-security fields -- is written only by the backend
    // through the Admin SDK (which bypasses these rules). An allowlist, so a field
    // added later is server-only by default. No web/mobile client writes this doc
    // directly today (verified 2026-10-05), so nothing legitimate is blocked.
    function profileFields() {
      return ['displayName', 'firstName', 'lastName', 'phone', 'company', 'address', 'photoURL', 'updatedAt'];
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(profileFields().concat(['uid', 'email', 'createdAt', 'tier']))
        && (!('tier' in request.resource.data) || request.resource.data.tier == 'starter');
      allow update: if isAdmin()
        || (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileFields()));
      allow delete: if isAdmin();
    }

    // Reports collection — scoped to userId
    match /reports/{reportId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }

    // API Keys — scoped to userId
    match /apiKeys/{keyId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // API Usage — append-only for authenticated users
    match /apiUsage/{usageId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update, delete: if false; // immutable
    }

    // CRM Collections — scoped to userId
    match /crmClients/{clientId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /crmAppointments/{apptId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /crmClaims/{claimId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Sales Leads — write-only for unauthenticated (contact form), read for admin
    match /salesLeads/{leadId} {
      allow create: if true; // anyone can submit contact form
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Enterprise Clients — scoped to userId, enterprise tier only
    match /enterpriseClients/{clientId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid && isEnterprise();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isEnterprise();
      allow read: if isAdmin();
    }
  }
}
