# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=admin@flacronenterprises.com
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
