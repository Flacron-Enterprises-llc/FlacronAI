# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=admin@flacronenterprises.com
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# MFA server-side enforcement rollout flag (NOT a secret -- a plain feature
# toggle, safe to log/inspect; see AUTHENTICATION_ARCHITECTURE.md §12 for the
# full design and activation checklist). Leave unset or 'false' in every
# environment for now -- only the literal string 'true' turns on enforcement.
# While unset/false: the backend still issues MFA assertions and both web
# and mobile clients still store/attach/clear them, but no protected route
# ever rejects a request for missing one -- existing production behavior for
# every user, MFA-enabled or not, is unchanged. Do NOT set to 'true' in
# production without first completing the activation checklist.
MFA_ENFORCEMENT_ENABLED=false

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_API_KEY=
FIREBASE_STORAGE_BUCKET=flacronai-c8dab.firebasestorage.app

# AI Providers
# AI providers — Claude (Anthropic) is primary, IBM watsonx is fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
WATSONX_API_KEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-3-8b-instruct
WATSONX_PROJECT_ID=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_AGENCY_ANNUAL=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_ENTERPRISE_ANNUAL=

# Email — AWS SES (transactional email)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=no-reply@flacronenterprises.com
SES_FROM_NAME=FlacronAI
SES_REPLY_TO=support@flacronenterprises.com
