# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=admin@flacronenterprises.com
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# MFA server-side enforcement rollout flag (NOT a secret -- a plain feature
# toggle, safe to log/inspect; see AUTHENTICATION_ARCHITECTURE.md §12 for the
# full design and activation checklist). Leave unset or 'false' in every
# environment for now -- only the literal string 'true' turns on enforcement.
# While unset/false: the backend still issues MFA assertions and both web
# and mobile clients still store/attach/clear them, but no protected route
# ever rejects a request for missing one -- existing production behavior for
# every user, MFA-enabled or not, is unchanged. Do NOT set to 'true' in
# production without first completing the activation checklist.
MFA_ENFORCEMENT_ENABLED=false

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_API_KEY=
FIREBASE_STORAGE_BUCKET=flacronai-c8dab.firebasestorage.app

# AI Providers
# AI providers — Claude (Anthropic) is primary, IBM watsonx is fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
WATSONX_API_KEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-3-8b-instruct
WATSONX_PROJECT_ID=

# Phase 43 -- OpenAI Preliminary Pricing Service ONLY (Claude/watsonx above
# remain the sole provider for report narrative/vision generation; this is a
# separate, narrowly scoped adapter — see backend/config/openai.js). No key
# is set in this worktree; every field below is a name + placeholder-safe
# default only, never a real secret. Phase 44 ("Central Plan Configuration")
# may later centralize the PRICING_*/OPENAI_MAX_* limits below into a
# PlanConfig document instead of raw env vars — not built yet.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_OUTPUT_TOKENS=2000
# Provider registry selector (backend/services/pricingProviders/registry.js)
# -- a client request body can never choose this; server config only.
PRICING_PROVIDER=openai
# Max line items priced in a single POST /:id/estimate-detail/price-suggestions call.
PRICING_MAX_ITEMS_PER_REQUEST=25
# Bounded transient-failure retry (timeout/5xx/429 only) before surfacing an error.
PRICING_MAX_RETRIES=2
PRICING_RETRY_BASE_MS=500
# How long a cached pricingSuggestionsCache/{fingerprint} entry stays fresh.
PRICING_CACHE_TTL_DAYS=30
# Per-user/IP rate limit for the pricing-suggestions route (requests/minute).
PRICING_RATE_LIMIT_PER_MIN=10
# Trust-boundary correction (2026-09-19): how long a generated pricing
# proposal (reports/{id}/pricingProposals/{proposalId}) stays applicable via
# PUT /:id/canonical-estimate's `appliedProposal` before it must be
# regenerated -- see backend/utils/pricingProposalStore.js.
PRICING_PROPOSAL_TTL_MINUTES=20

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_AGENCY_ANNUAL=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_ENTERPRISE_ANNUAL=

# Stripe — Phase 45 report-specific photo add-on packs (one-time purchases).
# Test/live are kept in separate vars and never mixed; which one is used is
# resolved automatically from whether STRIPE_SECRET_KEY starts with
# `sk_live_` (see backend/config/photoAddOnPacks.js). Leave unset until
# Stripe account access is granted and these Prices are created (see
# PHASES.md Phase 45's live-validation checklist) -- a pack with no
# configured Price ID for the active mode fails safely (STRIPE_ADDONS_NOT_CONFIGURED)
# without affecting anything else.
STRIPE_PRICE_PHOTOS_25_TEST=
STRIPE_PRICE_PHOTOS_25_LIVE=
STRIPE_PRICE_PHOTOS_50_TEST=
STRIPE_PRICE_PHOTOS_50_LIVE=
STRIPE_PRICE_PHOTOS_100_TEST=
STRIPE_PRICE_PHOTOS_100_LIVE=
STRIPE_PRICE_PHOTOS_250_TEST=
STRIPE_PRICE_PHOTOS_250_LIVE=
# Per-user/IP rate limit for POST /payment/photo-pack-checkout (requests/minute).
PHOTO_ADDON_CHECKOUT_RATE_LIMIT_PER_MIN=10

# Google Places/Geocoding — Phase 46 (Property Intelligence: Address
# Normalization & Google Integration). SERVER key only -- never the browser
# key (that one lives ONLY in frontend/.env.example's VITE_ var, never here).
# Leave blank until Google Cloud project access + billing + a properly
# IP/API-restricted server key exist (see PHASES.md Phase 46's live-
# validation checklist); address lookup safely degrades to
# ADDRESS_PROVIDER_UNAVAILABLE and manual entry remains fully usable with
# this unset. Restrict this key, once created, to the Geocoding API only,
# by production/dev server IP -- never ship an unrestricted key, and never
# reuse the browser key here.
GOOGLE_MAPS_SERVER_KEY=
# Selects the backend/services/addressProviders/registry.js adapter; 'google'
# is the only implementation today.
ADDRESS_PROVIDER=google
# Operational kill-switch independent of whether a key is set -- 'false'
# disables the feature outright (GET /reports/property-lookup/config then
# reports enabled:false). Defaults to enabled.
ADDRESS_LOOKUP_ENABLED=true
# Set to 'true' only once the FRONTEND's own VITE_GOOGLE_MAPS_BROWSER_KEY
# (frontend/.env.example) has actually been configured for the deployed
# environment -- this backend never reads that key itself; this flag exists
# purely so the sanitized public-config endpoint can advertise
# browserAutocompleteConfigured without holding any key.
GOOGLE_MAPS_BROWSER_KEY_CONFIGURED=false
GOOGLE_MAPS_TIMEOUT_MS=8000
GOOGLE_MAPS_MAX_RETRIES=1
# Per-user/IP rate limit for POST /reports/property-lookup/normalize (a real,
# billed Geocoding call each time).
ADDRESS_LOOKUP_RATE_LIMIT_PER_MIN=20
# How long a server-computed address normalization stays presentable/usable
# by PUT /:id/property-profile before it must be looked up again.
ADDRESS_NORMALIZATION_TTL_MINUTES=15

# Property Intelligence (detailed U.S. parcel/building data) — Phase 47
# (Property Intelligence: RealtyAPI U.S. Adapter & Report Integration).
# IMPORTANT: the live transport IS implemented. Once
# PROPERTY_INTELLIGENCE_ENABLED=true AND REALTY_API_KEY + REALTY_API_BASE_URL
# are all set, backend/services/propertyIntelligenceProviders/realtyApiProvider.js
# makes real, billed RealtyAPI requests. Leave the flag false (or the key/URL
# blank) to keep it off -- every lookup then safely resolves to
# PROPERTY_PROVIDER_NOT_CONFIGURED and manual/Google-only entry remains fully
# usable. In production the key comes only from the deployment's secret store
# (ECS task-definition secret); never put a real value in this file.
PROPERTY_INTELLIGENCE_ENABLED=false
REALTY_API_KEY=
REALTY_API_BASE_URL=
REALTY_API_TIMEOUT_MS=8000
REALTY_API_MAX_RETRIES=1
# Selects the backend/services/propertyIntelligenceProviders/registry.js
# adapter; 'realty_api' is the only implementation today.
PROPERTY_INTELLIGENCE_PROVIDER=realty_api
# Per-user/IP rate limit for POST /:id/property-lookup/intelligence (a real,
# billed provider call once one is actually configured).
PROPERTY_INTELLIGENCE_RATE_LIMIT_PER_MIN=10
# How long a server-computed property lookup stays presentable/usable by
# PUT /:id/property-intelligence before it must be looked up again.
PROPERTY_INTELLIGENCE_LOOKUP_TTL_MINUTES=30
# How long a non-ownership property-data value may be served from the
# shared, address-fingerprint-keyed cache before a fresh lookup is required.
PROPERTY_INTELLIGENCE_CACHE_TTL_DAYS=30

# Email — AWS SES (transactional email)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=no-reply@flacronenterprises.com
SES_FROM_NAME=FlacronAI
SES_REPLY_TO=support@flacronenterprises.com
